---
import ArchiveCard from "../components/ArchiveCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { works } from "../lib/content.js";

const description =
  "Matvi Mykula is an artist working with sculpture, lamps, grown materials, light, sound, and image.";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "Matvi Mykula",
      url: new URL("/", Astro.site).href,
      description,
    },
    {
      "@type": "Person",
      name: "Matvi Mykula",
      url: new URL("/", Astro.site).href,
      jobTitle: "Artist",
      sameAs: ["https://github.com/matvi-mykula"],
    },
  ],
};
---

<SiteLayout description={description} structuredData={structuredData}>
  <main class="page-shell">
    <section class="archive-intro" aria-labelledby="archive-title">
      <h1 id="archive-title" class="eyebrow">Artwork archive</h1>
    </section>
    <section class="archive-grid" aria-label="Artwork archive">
      {works.map((work, index) => <ArchiveCard work={work} eager={index < 2} />)}
    </section>
  </main>
</SiteLayout>
