---
import ArchiveCard from "../components/ArchiveCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { works } from "../lib/content.js";

const description =
  "Matvi ArtKive is an evolving archive of sculpture, lamps, grown materials, light, sound, and image.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Matvi ArtKive",
  url: "https://art-kive.vercel.app/",
  description,
};
---

<SiteLayout description={description} structuredData={structuredData}>
  <main class="page-shell">
    <section class="archive-intro" aria-labelledby="archive-title">
      <p class="eyebrow">Artwork archive</p>
      <h1 id="archive-title">Matvi ArtKive</h1>
      <p class="intro">
        An evolving archive of sculpture, lamps, grown materials, light, sound, and image.
      </p>
    </section>
    <section class="archive-grid" aria-label="Artwork archive">
      {works.map((work, index) => <ArchiveCard work={work} eager={index < 2} />)}
    </section>
  </main>
</SiteLayout>
